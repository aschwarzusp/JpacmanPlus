@@ -0,0 +1,69 @@
+package nl.tudelft.jpacman.board;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Controls the gates belonging to one independent switch circuit.
+ */
+public class Circuit {
+    private final int id;
+    private final List<Gate> gates = new ArrayList<>();
+    private final List<Switch> switches = new ArrayList<>();
+    private boolean open;
+
+    /**
+     * Creates a new circuit whose gates start closed.
+     *
+     * @param circuitId identifier used by map symbols and visual labels
+     */
+    public Circuit(int circuitId) {
+        this.id = circuitId;
+        this.open = false;
+    }
+
+    /** @return the circuit identifier */
+    public int getId() {
+        return id;
+    }
+
+    /** @return whether the latest circuit command is open */
+    public boolean isOpen() {
+        return open;
+    }
+
+    /** @return whether this circuit occurs in the current map */
+    public boolean isUsed() {
+        return !gates.isEmpty() || !switches.isEmpty();
+    }
+
+    /** @return whether this circuit has at least one gate */
+    public boolean hasGates() {
+        return !gates.isEmpty();
+    }
+
+    /** @return whether this circuit has at least one switch */
+    public boolean hasSwitches() {
+        return !switches.isEmpty();
+    }
+
+    void addGate(Gate gate) {
+        gates.add(gate);
+    }
+
+    void addSwitch(Switch circuitSwitch) {
+        switches.add(circuitSwitch);
+    }
+
+    /** Toggles the command and updates every gate in this circuit. */
+    public void toggle() {
+        open = !open;
+        for (Gate gate : gates) {
+            if (open) {
+                gate.open();
+            } else {
+                gate.close();
+            }
+        }
+    }
+}
diff --git a/src/main/java/nl/tudelft/jpacman/board/Gate.java b/src/main/java/nl/tudelft/jpacman/board/Gate.java
new file mode 100644
index 0000000..c8c9cf4
--- /dev/null
+++ b/src/main/java/nl/tudelft/jpacman/board/Gate.java
@@ -0,0 +1,83 @@
+package nl.tudelft.jpacman.board;
+
+import java.awt.Color;
+import nl.tudelft.jpacman.sprite.LabelSprite;
+import nl.tudelft.jpacman.sprite.Sprite;
+
+/** A gate whose entry permission is controlled by a circuit. */
+public class Gate extends Square {
+    private final Sprite closedSprite;
+    private final Sprite openSprite;
+    private final Sprite pendingSprite;
+    private boolean open;
+    private boolean pending;
+
+    /**
+     * Creates a gate in the closed state and registers it with its circuit.
+     *
+     * @param circuit circuit controlling this gate
+     * @param openBackground background used for an open gate
+     * @param closedBackground background used for a closed gate
+     */
+    public Gate(Circuit circuit, Sprite openBackground, Sprite closedBackground) {
+        this.openSprite = new LabelSprite(openBackground,
+            String.valueOf(circuit.getId()), Color.BLACK);
+        this.closedSprite = new LabelSprite(closedBackground,
+            String.valueOf(circuit.getId()), Color.WHITE);
+        this.pendingSprite = new LabelSprite(closedBackground,
+            circuit.getId() + "*", Color.YELLOW);
+        this.open = false;
+        this.pending = false;
+        circuit.addGate(this);
+    }
+
+    /** Opens the gate and cancels any pending closure. */
+    void open() {
+        open = true;
+        pending = false;
+    }
+
+    /**
+     * Closes an empty gate immediately or schedules closure after occupants leave.
+     */
+    void close() {
+        if (getOccupants().isEmpty()) {
+            open = false;
+            pending = false;
+        } else {
+            open = false;
+            pending = true;
+        }
+    }
+
+    /** Completes a pending closure when the last occupant leaves. */
+    void unitLeft() {
+        if (pending && getOccupants().isEmpty()) {
+            open = false;
+            pending = false;
+        }
+    }
+
+    /** @return true when the gate is fully open and accepts new entrants */
+    public boolean isOpen() {
+        return open && !pending;
+    }
+
+    /** @return true while the gate waits for its current occupants to leave */
+    public boolean isPending() {
+        return pending;
+    }
+
+    @Override
+    public boolean isAccessibleTo(Unit unit) {
+        return isOpen();
+    }
+
+    @Override
+    public Sprite getSprite() {
+        if (pending) {
+            return pendingSprite;
+        }
+        return open ? openSprite : closedSprite;
+    }
+}
